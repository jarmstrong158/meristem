{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meristem:entities",
  "title": "Entities",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "characters": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "enemies": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "npcs": { "type": "array", "items": { "$ref": "#/$defs/entity" } }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stats"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "stats": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "behavior_archetype": {
          "description": "References a mechanics archetype id (cross-ref enforced at validate_all).",
          "type": "string"
        },
        "ai": {
          "description": "Enemy AI archetype the compiler emits a script for. Enemies only; omitted means 'idle'. Tuning comes from this entity's own stats: patrol reads speed + patrol_distance, chase reads speed + aggro_radius.",
          "enum": ["idle", "patrol", "chase"]
        },
        "abilities": {
          "description": "Ability ids from the abilities domain (cross-ref enforced). Order is significant: they bind to the ability_1..N input actions in this order.",
          "type": "array",
          "items": { "type": "string" }
        },
        "sprite": { "$ref": "#/$defs/sprite" }
      }
    },
    "sprite": {
      "description": "A spec-addressable sprite: a generator archetype + its config (dec-0022).",
      "type": "object",
      "additionalProperties": false,
      "required": ["archetype"],
      "properties": {
        "archetype": { "enum": ["humanoid", "blob", "ghost", "quadruped", "flyer", "serpent", "spider", "raptor", "beetle", "weapon", "consumable", "pickup", "chest", "projectile", "tile"] },
        "config": { "type": "object" }
      }
    }
  }
}
