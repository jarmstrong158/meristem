extends CharacterBody2D
## Generated from the 'top_down_controller' mechanics archetype.
## Parameters are substituted by meristem-compiler from the manifest — do not
## hand-tune here; change the manifest and recompile.

const MOVE_SPEED: float = {{move_speed}}
const ACCEL: float = {{accel}}
const FRICTION: float = {{friction}}
## Reach and rate belong to the CONTROLLER archetype (how this control scheme
## swings), but the damage is the player ENTITY's atk stat -- how hard you hit is a
## property of the character, not of the control scheme.
const ATTACK_RANGE: float = {{attack_range}}
const ATTACK_COOLDOWN: float = {{attack_cooldown}}
const ATTACK_DAMAGE: int = {{attack_damage}}

@onready var _anim: AnimatedSprite2D = $AnimatedSprite2D

var _invuln: float = 0.0
var _attack_cd: float = 0.0
## Last non-zero input direction: a top-down swing goes where you are FACING, and
## standing still must not make you unable to attack.
var _facing: Vector2 = Vector2.DOWN

func _ready() -> void:
	add_to_group("player")
	# Arriving through a door: the scene placed us at this room's default spawn, so
	# move to the doorway we actually came in by. Read-once, so a later death-reload
	# leaves us at the default instead of the last doorway.
	var arrival: Variant = Game.take_pending_spawn()
	if arrival != null:
		global_position = arrival as Vector2

func _physics_process(delta: float) -> void:
	var dir: Vector2 = Input.get_vector("move_left", "move_right", "move_up", "move_down")
	if dir != Vector2.ZERO:
		_facing = dir.normalized()
		velocity = velocity.move_toward(dir * MOVE_SPEED, ACCEL * delta)
	else:
		velocity = velocity.move_toward(Vector2.ZERO, FRICTION * delta)
	if _anim != null:
		if velocity.length() > 5.0:
			_anim.play("walk")
			# cadence tracks actual speed so the feet don't skate
			_anim.speed_scale = clampf(velocity.length() / MOVE_SPEED, 0.4, 1.6)
			if absf(dir.x) > 0.0:
				_anim.flip_h = dir.x < 0.0
		else:
			_anim.play("idle")
			_anim.speed_scale = 1.0
	move_and_slide()
	_attack_cd = maxf(_attack_cd - delta, 0.0)
	if Input.is_action_just_pressed("attack") and _attack_cd <= 0.0:
		_swing()
	# contact damage: touching anything in the "enemies" group hurts, with i-frames
	if _invuln > 0.0:
		_invuln -= delta
		visible = int(_invuln * 12.0) % 2 == 0          # hurt flicker
		if _invuln <= 0.0:
			visible = true
	else:
		for i in range(get_slide_collision_count()):
			var other: Object = get_slide_collision(i).get_collider()
			if other is Node and (other as Node).is_in_group("enemies"):
				var atk: int = maxi(int((other as Node).get("atk")), 1)
				Game.take_damage(atk)
				_invuln = 1.0
				break

## A melee swing: everything in the "enemies" group within reach and in front of us
## takes ATTACK_DAMAGE. Deliberately a range+direction test rather than a physics
## hitbox -- it needs no extra collision nodes or layers in the generated scene, and
## the archetype has no attack ANIMATION yet, so there is nothing to sync frames to.
func _swing() -> void:
	_attack_cd = ATTACK_COOLDOWN
	for node in get_tree().get_nodes_in_group("enemies"):
		var enemy: Node2D = node as Node2D
		if enemy == null or not enemy.has_method("take_damage"):
			continue
		var to_enemy: Vector2 = enemy.global_position - global_position
		if to_enemy.length() > ATTACK_RANGE:
			continue
		# in FRONT of us: a ~130-degree arc around the facing direction, so you cannot
		# hit something behind your back
		if to_enemy.normalized().dot(_facing) < 0.35:
			continue
		enemy.take_damage(ATTACK_DAMAGE)
